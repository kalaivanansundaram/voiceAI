# Copy to .env and fill in locally. On Vercel, set these in Project → Settings → Environment Variables.
# Never paste these into chat, screenshots, or the repository.

SARVAM_API_KEY=

# Optional: shared passcode people must enter before using the hosted demo (protects your Sarvam credit).
ACCESS_CODE=

# Required on Vercel (serverless has no local disk). Leave empty locally to use SQLite in data/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides
# SARVAM_TTS_SPEAKER=simran
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_CHAT_MODEL=sarvam-105b-conversations
# FIRECRAWL_API_KEY=
